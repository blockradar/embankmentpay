# Copy to .env.local (gitignored) and fill in real values. Never commit real
# credentials — this file is the only env file tracked in git.

# "mock" (default) uses the in-memory dummy data adapters. "live" switches
# every operation's api.* facade to hit real Blockradar endpoints.
VITE_API_MODE=mock

VITE_BLOCKRADAR_BASE_URL=https://staging-api.blockradar.co/v1
VITE_BLOCKRADAR_API_KEY=

# Which settlement network the Dashboard defaults to: "arc" or "base".
VITE_DEFAULT_NETWORK=base

# Master wallet IDs per network, from the Blockradar dashboard/API.
VITE_WALLET_ID_ARC=
VITE_WALLET_ID_BASE=
