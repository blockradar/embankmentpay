# Copy to .env (gitignored) and fill in real values. Never commit real
# credentials — this file is the only env file tracked in git.

VITE_BLOCKRADAR_BASE_URL=https://api.blockradar.co/v1
VITE_BLOCKRADAR_API_KEY=

# Which settlement network the Dashboard defaults to: "arc" or "base".
VITE_DEFAULT_NETWORK=arc

# Mainnet master wallet IDs per network, from the Blockradar dashboard.
VITE_WALLET_ID_ARC=
VITE_WALLET_ID_BASE=
