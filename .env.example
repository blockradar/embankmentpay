# Copy to .env (gitignored) and fill in real values. Never commit real
# credentials — this file is the only env file tracked in git.
#
# These are read ONLY by the API server (server/config.ts). None of them
# start with VITE_, so Vite never bundles them into the browser build.

# Blockradar API key, generated in the dashboard with *Live Mode* on.
# If the key has an IP allowlist, add this machine's IP — otherwise every
# call fails with 401 Unauthorized.
# Set your webhook URL on the SAME page this key came from: Blockradar signs
# webhooks with that page's key, which is how server/routes/webhooks.ts
# verifies them.
BLOCKRADAR_API_KEY=

# Optional — the same URL serves testnet and mainnet (the key decides which).
BLOCKRADAR_BASE_URL=https://api.blockradar.co/v1

# Mainnet master wallet IDs, from the Blockradar dashboard. Arc is required;
# Base is optional (used to contrast gas paid in ETH vs USDC).
BLOCKRADAR_WALLET_ID_ARC=
BLOCKRADAR_WALLET_ID_BASE=

# Optional — mainnet guardrail: the most USDC a single withdrawal may send.
MAX_WITHDRAW_USDC=5

# Optional — port for the API server. Vite proxies /api here.
PORT=3001
